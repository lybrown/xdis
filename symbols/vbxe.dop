; VBXE (VideoBoard XE) FX core 1.26 registers at $D640
; Generated by tools/make-vbxe.py from the FX Core 1.26 Programmer's Manual
; (T. Piorek). Names used when instructions read an address that means
; something else when written are ;xdis read lines.

;       FX CORE REGISTERS

data VIDEO_CONTROL=$D640                    ;xdl_enabled, xcolor, no_trans, trans15
;xdis read CORE_VERSION=$D640               ; core type: $10 FX, $11 GTIA emu
data XDL_ADR0=$D641                         ;XDL address in VRAM, bits 0-7
;xdis read MINOR_REVISION=$D641             ; bit 7: RAMBO core; bits 6-0: BCD revision ($26 = v1.26)
data XDL_ADR1=$D642                         ;XDL address in VRAM, bits 8-15
data XDL_ADR2=$D643                         ;XDL address in VRAM, bits 16-18
data CSEL=$D644                             ;palette: colour number to change (CB write increments it)
data PSEL=$D645                             ;palette: palette number to change
data CR=$D646                               ;palette: red component (bits 7-1)
data CG=$D647                               ;palette: green component (bits 7-1)
data CB=$D648                               ;palette: blue component (bits 7-1); increments CSEL
data COLMASK=$D649                          ;AND mask for overlay/playfield collision detection
data COLCLR=$D64A                           ;any write clears COLDETECT
;xdis read COLDETECT=$D64A                  ; overlay/playfield collisions detected
data BL_ADR0=$D650                          ;BlitterList address in VRAM, bits 0-7
;xdis read BLT_COLLISION_CODE=$D650         ; collision code of the last blit (0: none)
data BL_ADR1=$D651                          ;BlitterList address in VRAM, bits 8-15
data BL_ADR2=$D652                          ;BlitterList address in VRAM, bits 16-18
data BLITTER_START=$D653                    ;bit 0: 1 starts the blitter, 0 stops it
;xdis read BLITTER_BUSY=$D653               ; non-zero while the blitter runs (bit 1 BUSY, bit 0 BCB_LOAD)
data IRQ_CONTROL=$D654                      ;bit 0: blitter-done IRQ enable; a write acknowledges
;xdis read IRQ_STATUS=$D654                 ; bit 0: blitter-done IRQ requested
data P0=$D655                               ;overlay/playfield priority for attribute map cells (P0)
data P1=$D656                               ;overlay/playfield priority for attribute map cells (P1)
data P2=$D657                               ;overlay/playfield priority for attribute map cells (P2)
data P3=$D658                               ;overlay/playfield priority for attribute map cells (P3)
data MEMAC_B_CONTROL=$D65D                  ;MEMAC-B: bit 7 CPU, bit 6 ANTIC enable, bits 4-0 16K bank at $4000
data MEMAC_CONTROL=$D65E                    ;MEMAC-A: bits 7-4 base page/16, bit 3 CPU, bit 2 ANTIC enable, bits 1-0 size
data MEMAC_BANK_SEL=$D65F                   ;MEMAC-A: bit 7 global enable, bits 6-0 VRAM bank
