; BBC Micro MOS: entry points, vectors and workspace
; Generated by tools/harvest-bbc.py. OS entry points and vectors use the
; official names from Acorn's Advanced User Guide; descriptions from py8dis
; (Steven Flintham, MIT license); workspace names from the MOS 1.20
; reassembly by Toby Nelson (tobylobster.github.io/mos).

;       OS ENTRY POINTS

code OSRDSC=$FFB9                           ;read byte from screen or paged ROM
code VDUCHR=$FFBC                           ;VDU character output
code OSEVEN=$FFBF                           ;generate an event
code GSINIT=$FFC2                           ;initialise string read
code GSREAD=$FFC5                           ;read a character from a string
code NVRDCH=$FFC8                           ;non-vectored OSRDCH
code NVWRCH=$FFCB                           ;non-vectored OSWRCH
code OSFIND=$FFCE                           ;open or close a file
code OSGBPB=$FFD1                           ;read or write a group of bytes
code OSBPUT=$FFD4                           ;write a byte to a file
code OSBGET=$FFD7                           ;read a byte from a file
code OSARGS=$FFDA                           ;read or write file attributes
code OSFILE=$FFDD                           ;load or save a file
code OSRDCH=$FFE0                           ;read a character
code OSASCI=$FFE3                           ;write a character, CR as CR LF
code OSNEWL=$FFE7                           ;write CR LF
code OSWRCR=$FFEC                           ;write CR
code OSWRCH=$FFEE                           ;write a character
code OSWORD=$FFF1                           ;OS word call
code OSBYTE=$FFF4                           ;OS byte call
code OSCLI=$FFF7                            ;command line interpreter

;       VECTORS

vector USERV=$200+1                         ;user vector
vector BRKV=$202+1                          ;BRK vector
vector IRQ1V=$204+1                         ;IRQ 1 vector
vector IRQ2V=$206+1                         ;IRQ 2 vector
vector CLIV=$208+1                          ;command line interpreter vector
vector BYTEV=$20A+1                         ;osbyte vector
vector WORDV=$20C+1                         ;osword vector
vector WRCHV=$20E+1                         ;write character vector
vector RDCHV=$210+1                         ;read character vector
vector FILEV=$212+1                         ;load/save file vector
vector ARGSV=$214+1                         ;load/save file parameters vector
vector BGETV=$216+1                         ;get byte from file vector
vector BPUTV=$218+1                         ;put byte to file vector
vector GBPBV=$21A+1                         ;multiple BPUT/BGET vector
vector FINDV=$21C+1                         ;open/close file vector
vector FSCV=$21E+1                          ;filing system control entry vector
vector EVNTV=$220+1                         ;event vector
vector UPTV=$222+1                          ;user print vector
vector NETV=$224+1                          ;econet vector
vector VDUV=$226+1                          ;unrecognised VDU command vector
vector KEYV=$228+1                          ;keyboard vector
vector INSV=$22A+1                          ;insert character vector
vector REMV=$22C+1                          ;remove character vector
vector CNPV=$22E+1                          ;count/purge buffer vector
vector IND1V=$230+1                         ;spare vector 1
vector IND2V=$232+1                         ;spare vector 2
vector IND3V=$234+1                         ;spare vector 3

