; Atari BASIC: page zero pointers and math routines in the cartridge
; Generated by tools/harvest-cc65.py from cc65 asminc/atari.inc
; (Freddy Offenga, Christian Groessler, Christian Krueger; zlib license)

data LOMEM=$80+1                    ;2-BYTE LOW MEMORY POINTER
data VNTP=$82+1                     ;2-BYTE VARIABLE NAME TABLE ADDRESS
data VNTD=$84+1                     ;2-BYTE VARIABLE NAME TABLE END + 1
data VVTP=$86+1                     ;2-BYTE VARIABLE VALUE TABLE
data STMTAB=$88+1                   ;2-BYTE STATEMENT TABLE ADDRESS
data STMCUR=$8A+1                   ;2-BYTE CURRENT STATEMENT POINTER
data STARP=$8C+1                    ;2-BYTE STRING AND ARRAY TABLE POINTER
data RUNSTK=$8E+1                   ;2-BYTE RUNTIME STACK ADDRESS
data BMEMTOP=$90+1                  ;2-BYTE TOP OF MEMORY POINTER
data STOPLN=$BA+1                   ;2-BYTE STOPPED LINE NUMBER
data ERRSAVE=$C3                    ;1-BYTE ERROR CODE
data PTABW=$C9                      ;1-BYTE TAB WIDTH
code COS=$BD73                      ;FR0 <- COS (FR0) CARRY
code SIN=$BD81                      ;FR0 <- SIN (FR0) DEGFLG (0=RAD,6=DEG) CARRY
code ATAN=$BE43                     ;FR0 <- ATAN(FR0) CARRY
code SQR=$BEB1                      ;FR0 <- ROOT(FR0) CARRY
