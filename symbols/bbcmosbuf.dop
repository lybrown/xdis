; BBC Micro MOS buffers and workspace ($0380-$0E00): cassette filing system,
; keyboard buffer, Tube service points, sound, buffers, soft keys and
; characters, NMI area. Programs often reuse this memory, so enable this set
; only for code that really uses the MOS there.
; Generated by tools/harvest-bbc.py; names from the MOS 1.20 reassembly by
; Toby Nelson (tobylobster.github.io/mos).

;       CASSETTE FILING SYSTEM WORKSPACE ($0380-$03DF)

data tapeBlockHeaderStart=$380              
data tapeBlockLoadAddressLow=$38C           
data tapeBlockLoadAddressMid1=$38D          
data tapeBlockLoadAddressMid2=$38E          
data tapeBlockLoadAddressHigh=$38F          
data tapeBlockExecutableAddressLow=$390     
