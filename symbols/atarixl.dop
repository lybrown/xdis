; Atari XL/XE OS: locations added or moved by the 1200XL and XL/XE OS, plus
; a few OS equates missing from sys.dop. Takes priority over sys.dop.
; Generated by tools/harvest-cc65.py from cc65 asminc/atari.inc
; (Freddy Offenga, Christian Groessler, Christian Krueger; zlib license)

data LNFLG=$0                       ;1-BYTE LNBUG FLAG (0 = NOT LNBUG)
data NGFLAG=$1                      ;1-BYTE MEMORY STATUS (0 = FAILURE)
data CMCMD=$7                       ;1-BYTE COMMAND COMMUNICATIONS
data ABUFPT=$1C+3                   ;4-BYTE ACMI BUFFER POINTER AREA
data ENTVEC=$2C+1                   ;2-BYTE (NOT USED)
data LTEMP=$36+1                    ;2-BYTE LOADER TEMPORARY
data ZCHAIN=$4A+1                   ;2-BYTE HANDLER LINKAGE CHAIN POINTER
data FKDEF=$60+1                    ;2-BYTE FUNCTION KEY DEFINITION TABLE
data PALNTS=$62                     ;1-BYTE PAL/NTSC INDICATOR (0 = NTSC)
data TOADR=$66+1                    ;2-BYTE DESTINATION ADDRESS
data FRMADR=$68+1                   ;2-BYTE SOURCE ADDRESS
data KEYDEF=$79+1                   ;2-BYTE KEY DEFINITION TABLE ADDRESS
data LCOUNT=$233                    ;1-BYTE RELOCATING LOADER RECORD
vector VPIRQ=$238+1                 ;2-BYTE PARALLEL DEVICE IRQ VECTOR
data RECLEN=$245                    ;1-BYTE RELOCATING LOADER RECORD LENGTH
data PDVMSK=$247                    ;1-BYTE PARALLEL DEVICE SELECTION MASK
data SHPDVS=$248                    ;1-BYTE PDVS (PARALLEL DEVICE SELECT)
data PDIMSK=$249                    ;1-BYTE PARALLEL DEVICE IRQ SELECTION
data RELADR=$24A+1                  ;2-BYTE RELOCATING LOADER RELATIVE ADR.
data PPTMPA=$24C                    ;1-BYTE PARALLEL DEVICE HANDLER TEMPORARY
data PPTMPX=$24D                    ;1-BYTE PARALLEL DEVICE HANDLER TEMPORARY
data CHSALT=$26B                    ;1-BYTE CHARACTER SET ALTERNATE
data VSFLAG=$26C                    ;1-BYTE FINE VERTICAL SCROLL COUNT
data KEYDIS=$26D                    ;1-BYTE KEYBOARD DISABLE
data FINE=$26E                      ;1-BYTE FINE SCROLLING MODE
data HIBYTE=$288                    ;1-BYTE RELOCATING LOADER HIGH BYTE
data IMASK=$28B                     ;(NOT USED)
vector JVECK=$28C+1                 ;2-BYTE JUMP VECTOR OR TEMPORARY
data NEWADR=$28E+1                  ;2-BYTE RELOCATING ADDRESS
data CRETRY=$29C                    ;1-BYTE NUMBER OF COMMAND FRAME RETRIES
data DRETRY=$2BD                    ;1-BYTE NUMBER OF DEVICE RETRIES
data PARMBL=$2C9+5                  ;6-BYTE RELOCATING LOADER PARAMETER
data RUNADR=$2C9+1                  ;2-BYTE RUN ADDRESS
data HIUSED=$2CB+1                  ;2-BYTE HIGHEST NON-ZERO PAGE ADDRESS
data ZHIUSE=$2CD+1                  ;2-BYTE HIGHEST ZERO PAGE ADDRESS
data OLDPAR=$2CF+5                  ;6-BYTE RELOCATING LOADER PARAMETER
data GBYTEA=$2CF+1                  ;2-BYTE GET-BYTE ROUTINE ADDRESS
data LOADAD=$2D1+1                  ;2-BYTE NON-ZERO PAGE LOAD ADDRESS
data ZLOADA=$2D3+1                  ;2-BYTE ZERO PAGE LOAD ADDRESS
data DSCTLN=$2D5+1                  ;2-BYTE DISK SECTOR LENGTH
data ACMISR=$2D7+1                  ;2-BYTE ACMI INTERRUPT SERVICE ROUTINE
data KRPDEL=$2D9                    ;1-BYTE AUTO-REPEAT DELAY
data KEYREP=$2DA                    ;1-BYTE AUTO-REPEAT RATE
data NOCLIK=$2DB                    ;1-BYTE KEY CLICK DISABLE
data HELPFG=$2DC                    ;1-BYTE HELP KEY FLAG (0 = NO HELP)
data DMASAV=$2DD                    ;1-BYTE SDMCTL SAVE/RESTORE
data PBPNT=$2DE                     ;1-BYTE PRINTER BUFFER POINTER
data PBUFSZ=$2DF                    ;1-BYTE PRINTER BUFFER SIZE
data HNDLOD=$2E9                    ;1-BYTE USER LOAD FLAG
data NEWROW=$2F5                    ;1-BYTE DRAW DESTINATION ROW
data NEWCOL=$2F6+1                  ;2-BYTE DRAW DESTINATION COLUMN
data ROWINC=$2F8                    ;1-BYTE DRAW ROW INCREMENT
data COLINC=$2F9                    ;1-BYTE DRAW COLUMN INCREMENT
data JMPERS=$30E                    ;1-BYTE JUMPER OPTIONS
data TEMP2=$313                     ;1-BYTE TEMPORARY
data PTIMOT=$314                    ;1-BYTE PRINTER TIMEOUT
data PUPBT1=$33D                    ;1-BYTE POWER-UP VALIDATION BYTE 1
data PUPBT2=$33E                    ;1-BYTE POWER-UP VALIDATION BYTE 2
data PUPBT3=$33F                    ;1-BYTE POWER-UP VALIDATION BYTE 3
data ICAX4=$34D                     ;1-BYTE FOURTH AUXILIARY INFORMATION
data ICAX5=$34E                     ;1-BYTE FIFTH AUXILIARY INFORMATION
data SUPERF=$3E8                    ;1-BYTE EDITOR SUPER FUNCTION FLAG
data CKEY=$3E9                      ;1-BYTE CASSETTE BOOT REQUEST FLAG
data CASSBT=$3EA                    ;1-BYTE CASSETTE BOOT FLAG
data CARTCK=$3EB                    ;1-BYTE CARTRIDGE EQUIVALENCE CHECK
data DERRF=$3EC                     ;1-BYTE SCREEN OPEN ERROR FLAG
data ACMVAR=$3ED                    ;11 BYTES RESERVED FOR ACMI
data BASICF=$3F8                    ;1-BYTE BASIC SWITCH FLAG
data MINTLK=$3F9                    ;1-BYTE ACMI MODULE INTERLOCK
data GINTLK=$3FA                    ;1-BYTE CARTRIDGE INTERLOCK
data CHLINK=$3FB+1                  ;2-BYTE LOADED HANDLER CHAIN LINK
data PBI=$D100                      ;PARALLEL BUS INTERFACE AREA
data PDVI=$D1FF                     ;PARALLEL DEVICE IRQ STATUS
data PDVS=$D1FF                     ;PARALLEL DEVICE SELECT
