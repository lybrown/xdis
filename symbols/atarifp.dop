data FR0=$D4+5                      ;6-BYTE REGISTER 0
data FR0M=$D5+4                     ;5-BYTE REGISTER 0 MANTISSA
data QTEMP=$D9                      ;1-BYTE TEMPORARY
data FRE=$DA+5                      ;6-BYTE (INTERNAL) REGISTER E
data FR1=$E0                        ;FP REG1
data FR1M=$E1+4                     ;5-BYTE REGISTER 1 MANTISSA
data FR2=$E6+5                      ;6-BYTE (INTERNAL) REGISTER 2
data FRX=$EC                        ;1-BYTE TEMPORARY
data EEXP=$ED                       ;VALUE OF E
data FRSIGN=$EE                     ;1-BYTE FLOATING POINT SIGN
data NSIGN=$EE                      ;SIGN OF #
data PLYCNT=$EF                     ;1-BYTE POLYNOMIAL DEGREE
data ESIGN=$EF                      ;SIGN OF EXPONENT
data SGNFLG=$F0                     ;1-BYTE SIGN FLAG
data FCHRFLG=$F0                    ;1ST CHAR FLAG
data XFMFLG=$F1                     ;1-BYTE TRANSFORM FLAG
data DIGRT=$F1                      ;# OF DIGITS RIGHT OF DECIMAL
data CIX=$F2                        ;CURRENT INPUT INDEX
data INBUFF=$F3                     ;POINTS TO USER'S LINE INPUT BUFFER
data ZTEMP1=$F5+1                   ;2-BYTE TEMPORARY
data ZTEMP4=$F7+1                   ;2-BYTE TEMPORARY
data ZTEMP3=$F9+1                   ;2-BYTE TEMPORARY
data FLPTR=$FC+1                    ;2-BYTE FLOATING POINT NUMBER POINTER
data FPTR2=$FE+1                    ;2-BYTE FLOATING POINT NUMBER POINTER
data LBPR1=$57E                     ;LBUFF PREFIX 1
data LBPR2=$57F                     ;LBUFF PREFIX 2
data LBUFF=$580+7F                  ;128-BYTE LINE BUFFER
data PLYARG=$5E0+5                  ;6-BYTE FLOATING POINT POLYNOMIAL ARGUMENT
data FPSCR=$5E6+5                   ;6-BYTE FLOATING POINT TEMPORARY
data FPSCR1=$5EC+5                  ;6-BYTE FLOATING POINT TEMPORARY
code AFP=$D800                      ;CONVERT ASCII TO FLOATING POINT
code FASC=$D8E6                     ;CONVERT FLOATING POINT TO ASCII
code IFP=$D9AA                      ;CONVERT INTEGER TO FLOATING POINT
code FPI=$D9D2                      ;CONVERT FLOATING POINT TO INTEGER
code ZFR0=$DA44                     ;ZERO FR0
code ZF1=$DA46                      ;ZERO FLOATING POINT NUMBER
code FSUB=$DA60                     ;SUBTRACT FLOATING POINT NUMBERS
code FADD=$DA66                     ;ADD FLOATING POINT NUMBERS
code FMUL=$DADB                     ;MULTIPLY FLOATING POINT NUMBERS
code FDIV=$DB28                     ;DIVIDE FLOATING POINT NUMBERS
code PLYEVL=$DD40                   ;EVALUATE FLOATING POINT POLYNOMIAL
code FLD0R=$DD89                    ;LOAD FLOATING POINT NUMBER
code FLD0P=$DD8D                    ;LOAD FLOATING POINT NUMBER
code FLD1R=$DD98                    ;LOAD FLOATING POINT NUMBER
code PLD1P=$DD9C                    ;LOAD FLOATING POINT NUMBER
code FST0R=$DDA7                    ;STORE FLOATING POINT NUMBER
code FST0P=$DDAB                    ;STORE FLOATING POINT NUMBER
code FMOVE=$DDB6                    ;MOVE FLOATING POINT NUMBER
code EXP=$DDC0                      ;CALCULATE FLOATING POINT EXPONENTIAL
code EXP10=$DDCC                    ;CALCULATE FLOATING POINT BASE 10 EXPONENTIAL
code LOG=$DECD                      ;CALCULATE FLOATING POINT LOGARITHM
code LOG10=$DED1                    ;CALCULATE FLOATING POINT BASE 10 LOGARITHM
